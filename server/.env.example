# APIForge Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://localhost:27017/apiforge
MONGODB_TEST_URI=mongodb://localhost:27017/apiforge_test

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Load Testing Configuration
MAX_VIRTUAL_USERS=500
MAX_TEST_DURATION=300
MAX_CONCURRENT_TESTS=2
K6_PATH=k6

# Demo API Configuration
DEMO_PORT=5001
DEMO_API_URL=http://localhost:5001
